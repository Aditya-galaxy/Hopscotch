# Copy to .env and fill. Never commit .env.
GOOGLE_CLOUD_PROJECT=
# Model location. Gemini 3.x and Gemma are served ONLY from `global`;
# a regional call 404s even though models.list() shows them there.
GOOGLE_CLOUD_LOCATION=global
# Model Armor is genuinely regional and has no global endpoint.
MODEL_ARMOR_LOCATION=us-central1
GOOGLE_GENAI_USE_VERTEXAI=true

FIRESTORE_DATABASE=(default)
CASES_COLLECTION=cases
AUDIT_COLLECTION=audit
DEADLETTER_COLLECTION=deadletter

# Model Armor template. Created by deploy/day1.sh; defaults to
# agentx-skill-review when unset.
MODEL_ARMOR_TEMPLATE=agentx-skill-review

# Vertex AI Agent Engine instance hosting Memory Bank.
# Create with: ./deploy/create_agent_engine.sh
AGENT_ENGINE_ID=
