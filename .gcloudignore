# Keep the Cloud Build upload to what the job actually runs.
# Without this, .venv alone is hundreds of megabytes per deploy.
.git/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
data/corpora/
tests/
docs/
.DS_Store
# NOT *.mp4 -- data/media/evaluation-timeline.mp4 is the one cached Veo render
# the dashboard plays, it is 600K, and the Dockerfile copies data/media/
# explicitly. Excluding it shipped an image whose video player pointed at
# nothing, which is worse than having no player.
*.wav
